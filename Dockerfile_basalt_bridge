FROM ros:jazzy-ros-base

# =========================================================
# BasaltVIO bridge container (ROS2 Jazzy)
#
# On-device BasaltVIO runs on the OAK-D (RVC3).  This
# container reads the VIO pose and depth point cloud via
# the depthai Python API and republishes them as ROS2 topics.
#
# Owns the OAK-D USB device — do NOT run oak_driver
# alongside this container.
#
# Published topics:
#   /odom    nav_msgs/Odometry
#   /points  sensor_msgs/PointCloud2
# =========================================================

RUN apt-get update && apt-get install -y \
    python3-numpy \
    python3-pip \
    ros-jazzy-sensor-msgs-py \
    ros-jazzy-nav-msgs \
&& rm -rf /var/lib/apt/lists/*

RUN pip3 install --break-system-packages depthai==3.7.1

COPY scripts/basalt_bridge.py          /scripts/basalt_bridge.py
COPY scripts/pointcloud_test.py        /scripts/pointcloud_test.py
COPY scripts/vio_pointcloud_bridge.py  /scripts/vio_pointcloud_bridge.py
COPY scripts/fix_imu_calibration.py    /scripts/fix_imu_calibration.py

RUN echo "source /opt/ros/jazzy/setup.bash" >> /root/.bashrc

RUN printf '#!/bin/bash\nsource /opt/ros/jazzy/setup.bash\nexec "$@"\n' \
    > /entrypoint.sh && chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["python3", "/scripts/basalt_bridge.py"]
