FROM ros:humble-ros-base

# =========================================================
# BasaltVIO container (ROS2 Humble)
#
# On-device BasaltVIO runs on the OAK-D (RVC2).  This
# container reads the VIO pose and depth point cloud via
# the depthai Python API and republishes them as ROS2 topics.
#
# Owns the OAK-D USB device — do NOT run oak_driver
# alongside this container.
#
# Published topics:
#   /odom    nav_msgs/Odometry
#   /points  sensor_msgs/PointCloud2
# =========================================================

RUN apt-get update && apt-get install -y \
    python3-numpy \
    python3-pip \
    ros-humble-sensor-msgs-py \
    ros-humble-nav-msgs \
&& rm -rf /var/lib/apt/lists/*

RUN pip3 install --break-system-packages depthai==3.7.1

COPY scripts/vio_pointcloud.py          /scripts/vio_pointcloud.py

RUN echo "source /opt/ros/humble/setup.bash" >> /root/.bashrc

RUN printf '#!/bin/bash\nsource /opt/ros/humble/setup.bash\nexec "$@"\n' \
    > /entrypoint.sh && chmod +x /entrypoint.sh

ENV SCRIPT=/scripts/vio_pointcloud.py

ENTRYPOINT ["/entrypoint.sh"]
CMD ["sh", "-c", "exec python3 $SCRIPT"]
